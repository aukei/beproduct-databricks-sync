BEPRODUCT_CLIENT_ID=your_client_id_here
BEPRODUCT_CLIENT_SECRET=your_client_secret_here
BEPRODUCT_REFRESH_TOKEN=your_refresh_token_here
BEPRODUCT_COMPANY_DOMAIN=YourCompanyDomain
BEPRODUCT_CALLBACK_URL=http://localhost:8765/callback
DATABRICKS_HOST=https://adb-781381861146191.11.azuredatabricks.net
DATABRICKS_PAT=your_personal_access_token_here
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id_here

# Phase 9b — NT Orbit Duty Tools API (Microsoft Entra ID delegated OAuth2).
# Used only by scripts/nt_orbit_oauth_setup.py for the ONE-TIME interactive
# login; the resulting refresh_token is then stored in the Databricks secret
# scope "beproduct" (keys nt_orbit_tenant_id/client_id/client_secret/refresh_token),
# NOT read from this .env at runtime. See dtc/python/client/entra_auth.py.
NT_ORBIT_TENANT_ID=your_entra_tenant_id_here
NT_ORBIT_CLIENT_ID=your_entra_app_client_id_here
NT_ORBIT_CLIENT_SECRET=
NT_ORBIT_REDIRECT_URI=http://localhost:8765/callback
