BEPRODUCT_CLIENT_ID=your_client_id_here
BEPRODUCT_CLIENT_SECRET=your_client_secret_here
BEPRODUCT_REFRESH_TOKEN=your_refresh_token_here
BEPRODUCT_COMPANY_DOMAIN=YourCompanyDomain
BEPRODUCT_CALLBACK_URL=http://localhost:8765/callback
DATABRICKS_HOST=https://adb-781381861146191.11.azuredatabricks.net
DATABRICKS_PAT=your_personal_access_token_here
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id_here

# Phase 9b — NT Orbit Duty Tools API (Microsoft Entra ID delegated OAuth2).
# Used by scripts/nt_orbit_oauth_setup.py for the ONE-TIME interactive login,
# and by dtc/tests/test_nt_orbit_live.py for the live/network test. Real
# VALUES belong ONLY in your local, untracked .env (never in this tracked
# .env.example) and in the Databricks secret scope "beproduct" (keys
# nt_orbit_tenant_id/nt_orbit_client_id/nt_orbit_client_secret/
# nt_orbit_refresh_token) — NOT read from .env at Databricks runtime.
# See dtc/python/client/entra_auth.py.
#
# This IS a dedicated confidential app registration for Phase 9b (has its own
# client_secret), but the Entra sign-in itself is still DELEGATED-USER
# (auchunkei@lifung.com) — NT Orbit authorizes the signed-in person, not the
# app. Because it's a dedicated registration, ITS redirect URI is ours to
# register, so the recommended one-time login is:
#   python scripts/nt_orbit_oauth_setup.py --flow authcode \
#     --redirect-uri http://localhost:8765/callback
# (register that same URI on the app in the Entra portal first). `--flow
# manual` (Postman's browser-callback, no redirect-URI registration needed)
# and `--flow devicecode` remain as no-portal-access fallbacks.
NT_ORBIT_TENANT_ID=c4d8a220-a9ec-4572-8c77-ab36a3ecdbae  # LiFung tenant
NT_ORBIT_CLIENT_ID=your_nt_orbit_app_client_id_here
NT_ORBIT_CLIENT_SECRET=your_nt_orbit_app_client_secret_here
NT_ORBIT_REDIRECT_URI=http://localhost:8765/callback
